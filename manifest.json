{
  "manifest_version": 3,
  "name": "Counter-Strike Stats Viewer",
  "version": "2.0.0",
  "description": "Extension that displays Counter-Strike stats directly on the Steam profile",
  "icons": {
    "16": "imgs/logo16.png",
    "48": "imgs/logo48.png",
    "128": "imgs/logo128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "imgs/logo16.png",
      "48": "imgs/logo48.png",
      "128": "imgs/logo128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://steamcommunity.com/id/*",
        "*://steamcommunity.com/profiles/*"
      ],
      "js": [
        "src/scripts/utils/constants.js",
        "src/scripts/utils/dom.js",
        "src/scripts/utils/messaging.js",
        "src/scripts/utils/section.js",
        "src/scripts/sections/csstats-section.js",
        "src/scripts/sections/faceit-section.js",
        "src/scripts/sections/account-section.js",
        "src/scripts/content.js"
      ],
      "css": [
        "src/styles/content.css"
      ]
    }
  ],
  "host_permissions": [
    "*://steamcommunity.com/*",
    "*://shapi.jagoba.dev/*",
    "*://csstats.gg/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "imgs/*.png",
        "imgs/**/*.svg"
      ],
      "matches": [
        "*://steamcommunity.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/scripts/service-worker.js",
    "scripts": [
      "src/scripts/service-worker.js"
    ],
    "type": "module"
  }
}
