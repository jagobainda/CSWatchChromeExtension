{
  "manifest_version": 3,
  "name": "Counter-Strike Stats Extension",
  "version": "3.0.0",
  "description": "Displays Counter-Strike stats directly on Steam profiles",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "cswatch@jagoba.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "icons": {
    "16": "imgs/logo16.png",
    "48": "imgs/logo48.png",
    "128": "imgs/logo128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "imgs/logo16.png",
      "48": "imgs/logo48.png",
      "128": "imgs/logo128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*"
      ],
      "js": [
        "src/scripts/utils/constants.js",
        "src/scripts/utils/dom.js",
        "src/scripts/utils/messaging.js",
        "src/scripts/utils/section.js",
        "src/scripts/sections/csstats-section.js",
        "src/scripts/sections/faceit-section.js",
        "src/scripts/sections/account-section.js",
        "src/scripts/content.js"
      ],
      "css": [
        "src/styles/content.css"
      ]
    }
  ],
  "host_permissions": [
    "https://csstats.gg/*",
    "https://steamcommunity.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "imgs/csgo/*",
        "imgs/faceit/*",
        "imgs/icons/*",
        "imgs/logos/*",
        "imgs/premiere/*"
      ],
      "matches": [
        "https://steamcommunity.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/scripts/service-worker.js",
    "scripts": [
      "src/scripts/service-worker.js"
    ],
    "type": "module"
  }
}
